{
  "manifest_version": 3,
  "name": "Squadrats for Mapy.com",
  "version": "0.1.0",
  "description": "Overlays the Squadrats / squadratinhos grid and your visited tiles on Mapy.com so you can plan routes around the tiles you still need.",
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://mapy.com/*", "https://*.mapy.com/*", "https://mapy.cz/*", "https://*.mapy.cz/*"],
      "js": ["geo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Squadrats for Mapy.com",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
